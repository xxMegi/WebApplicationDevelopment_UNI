<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<%- include('partials/header') %>

<main class="container mt-5">
  <h1 class="text-center mb-4">Moje zamówienia</h1>

  <% if (orders.length === 0) { %>
    <div class="alert alert-info text-center">
      Nie masz jeszcze żadnych zamówień.
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
        <tr>
          <th>Numer</th>
          <th>Data</th>
          <th>Status</th>
          <th>Płatność</th>
          <th>Dostawa</th>
          <th>Kwota</th>
        </tr>
        </thead>
        <tbody>
        <% orders.forEach(order => { %>
          <tr>
            <td>#<%= order.id %></td>
            <td><%= new Date(order.created_at).toLocaleString('pl-PL') %></td>
            <td>
              <%
                const statusMap = {
                  new: 'Nowe',
                  paid: 'Opłacone',
                  shipped: 'Wysłane',
                  cancelled: 'Anulowane'
                };
              %>

              <%= statusMap[order.status] || order.status %>
            </td>
            <td>
              <%
                const paymentMap = {
                  cash: 'Gotówka',
                  card: 'Karta',
                  blik: 'BLIK'
                };
              %>

              <%= paymentMap[order.payment_method] || order.payment_method %>
            </td>
            <td>
                <%
                  const deliveryMap = {
                    address: 'Na podany adres',
                    paczkomat: 'Paczkomat',
                    personal: 'Odbiór osobisty',
                    courier: 'Kurier',
                    parcel_locker: 'Paczkomat',
                    pickup: 'Odbiór osobisty'
                  };
                %>

                <%= deliveryMap[order.delivery_method] || order.delivery_method %>
            </td>
            <td><%= Number(order.total_price).toFixed(2) %> PLN</td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <div class="text-center mt-4">
    <a href="/shop" class="btn btn-dark">Wróć do sklepu</a>
  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>